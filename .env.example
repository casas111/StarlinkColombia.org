# Authentication for the Hermes intake webhook.
HERMES_WEBHOOK_SECRET=

# Bearer token shared with the Google Sheet synchronization process.
SHEET_SYNC_TOKEN=

# Optional AI-assisted prioritization.
OPENAI_API_KEY=
OPENAI_PRIORITY_MODEL=gpt-5.6-terra

# Owner-only hosted secret used to verify per-operator MCP tokens. Use at least 32 characters.
MCP_AUTH_SECRET=

# Local MCP client configuration. Never commit a populated operator token.
STARLINK_BACKEND_URL=https://starlinkcolombia.org
STARLINK_MCP_TOKEN=
